# =====================================================================
# ClipKeeper Server（Vercel + Neon）環境變數範例
# 複製為 .env 可用於本地測試；部屬時在 Vercel
# → Settings → Environment Variables 設定相同名稱
# =====================================================================

# Neon pooled 連線字串（結尾 -pooler 那條）
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.c-1.aws.neon.tech/neondb?sslmode=require

# 選用：設定後所有 API 請求必須帶相同值的 header `x-api-key`
API_KEY=